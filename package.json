  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "wrangler types && tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "type-check": "wrangler types && tsc -b",
    "test": "vitest run",
    "lint": "oxlint",
    "cf-typegen": "wrangler types",
    "fixtures": "node scripts/capture-fixtures.mjs",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "node scripts/local-db.mjs migrate",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:accounts": "node scripts/verify-accounts.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
